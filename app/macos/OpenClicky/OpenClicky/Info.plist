<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>clicky-bro</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Clicky Bro uses your microphone when you start speaking to it.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Clicky Bro requests screen access to see only the window you select.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Clicky Bro uses speech recognition to transcribe speech you choose to record.</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>VoiceTranscriptionProvider</key>
	<string>apple</string>
</dict>
</plist>
